================================================================================
Query Name: Students_All
--------------------------------------------------------------------------------
SELECT SCHOOL_TYPE.Order_New, Thana_List.DIVISION_NAME, Thana_List.DISTRICT_NAME, Thana_List.UPAZILA_NAME, SCHOOL_TYPE.Order_New, GEN_INFO.SCHOOL_TYPE_ID, STD_ADMISSION.SCHOOL_CODE, SCHOOL_TYPE.NAME, GEN_INFO.SCHOOL_NAME_ENG, STD_ADMISSION.PRE_PRIMARY_BOY, STD_ADMISSION.PRE_PRIMARY_GIRL, STD_ADMISSION.ONE_BOY, STD_ADMISSION.ONE_GIRL, STD_ADMISSION.TWO_BOY, STD_ADMISSION.TWO_GIRL, STD_ADMISSION.THREE_BOY, STD_ADMISSION.THREE_GIRL, STD_ADMISSION.FOUR_BOY, STD_ADMISSION.FOUR_GIRL, STD_ADMISSION.FIVE_BOY, STD_ADMISSION.FIVE_GIRL, [ONE_BOY]+[TWO_BOY]+[THREE_BOY]+[FOUR_BOY]+[FIVE_BOY]+[ONE_GIRL]+[TWO_GIRL]+[THREE_GIRL]+[FOUR_GIRL]+[FIVE_GIRL] AS TotalStudent, [One_BOY]+[Two_BOY]+[THREE_BOY]+[Four_BOY]+[Five_BOY] AS Boys, [One_Girl]+[Two_Girl]+[THREE_Girl]+[Four_Girl]+[Five_Girl] AS Girls, [ONE_BOY]+[TWO_BOY]+[THREE_BOY]+[FOUR_BOY]+[FIVE_BOY]+[ONE_GIRL]+[TWO_GIRL]+[THREE_GIRL]+[FOUR_GIRL]+[FIVE_GIRL]+[PRE_PRIMARY_BOY]+[PRE_PRIMARY_Girl] AS StuwithPPE, GEN_INFO.[24 School], STD_ADMISSION.SIX_EIGHT_BOY, STD_ADMISSION.SIX_EIGHT_GIRL, Teacher.Teacher
