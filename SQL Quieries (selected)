Query Name: Disability_Ethnic Students
--------------------------------------------------------------------------------
SELECT ethnic.SCHOOL_CODE, DISABLE_ADMISSION.UPAZILA_CODE, Sum(DISABLE_ADMISSION.PRE_PRIMARY_BOY) AS SumOfPRE_PRIMARY_BOY1, Sum(DISABLE_ADMISSION.PRE_PRIMARY_GIRL) AS SumOfPRE_PRIMARY_GIRL1, Sum(DISABLE_ADMISSION.ONE_BOY) AS SumOfONE_BOY1, Sum(DISABLE_ADMISSION.ONE_GIRL) AS SumOfONE_GIRL1, Sum(DISABLE_ADMISSION.TWO_BOY) AS SumOfTWO_BOY1, Sum(DISABLE_ADMISSION.TWO_GIRL) AS SumOfTWO_GIRL1, Sum(DISABLE_ADMISSION.THREE_BOY) AS SumOfTHREE_BOY1, Sum(DISABLE_ADMISSION.THREE_GIRL) AS SumOfTHREE_GIRL1, Sum(DISABLE_ADMISSION.FOUR_BOY) AS SumOfFOUR_BOY1, Sum(DISABLE_ADMISSION.FOUR_GIRL) AS SumOfFOUR_GIRL1, Sum(DISABLE_ADMISSION.FIVE_BOY) AS SumOfFIVE_BOY1, Sum(DISABLE_ADMISSION.FIVE_GIRL) AS SumOfFIVE_GIRL1
FROM ethnic INNER JOIN DISABLE_ADMISSION ON ethnic.SCHOOL_CODE = DISABLE_ADMISSION.SCHOOL_CODE
GROUP BY ethnic.SCHOOL_CODE, DISABLE_ADMISSION.UPAZILA_CODE;



================================================================================
Query Name: ethnic
--------------------------------------------------------------------------------
SELECT [Ethnic Minority_enrollment].SCHOOL_CODE, Sum([Ethnic Minority_enrollment].PRE_PRIMARY_BOY) AS SumOfPRE_PRIMARY_BOY, Sum([Ethnic Minority_enrollment].PRE_PRIMARY_GIRL) AS SumOfPRE_PRIMARY_GIRL, Sum([Ethnic Minority_enrollment].ONE_BOY) AS SumOfONE_BOY, Sum([Ethnic Minority_enrollment].ONE_GIRL) AS SumOfONE_GIRL, Sum([Ethnic Minority_enrollment].TWO_BOY) AS SumOfTWO_BOY, Sum([Ethnic Minority_enrollment].TWO_GIRL) AS SumOfTWO_GIRL, Sum([Ethnic Minority_enrollment].THREE_BOY) AS SumOfTHREE_BOY, Sum([Ethnic Minority_enrollment].THREE_GIRL) AS SumOfTHREE_GIRL, Sum([Ethnic Minority_enrollment].FOUR_BOY) AS SumOfFOUR_BOY, Sum([Ethnic Minority_enrollment].FOUR_GIRL) AS SumOfFOUR_GIRL, Sum([Ethnic Minority_enrollment].FIVE_BOY) AS SumOfFIVE_BOY, Sum([Ethnic Minority_enrollment].FIVE_GIRL) AS SumOfFIVE_GIRL, [SumOfFIVE_BOY]+[SumOfFIVE_GIRL]+[SumOfFOUR_BOY]+[SumOfFOUR_GIRL]+[SumOfONE_BOY]+[SumOfONE_GIRL]+[SumOfPRE_PRIMARY_BOY]+[SumOfPRE_PRIMARY_GIRL]+[SumOfTHREE_BOY]+[SumOfTHREE_GIRL]+[SumOfTWO_BOY]+[SumOfTWO_GIRL] AS Total
FROM [Ethnic Minority_enrollment]
GROUP BY [Ethnic Minority_enrollment].SCHOOL_CODE
HAVING (((Sum([Ethnic Minority_enrollment].PRE_PRIMARY_BOY))>0) AND ((Sum([Ethnic Minority_enrollment].PRE_PRIMARY_GIRL))>0) AND ((Sum([Ethnic Minority_enrollment].ONE_BOY))>0) AND ((Sum([Ethnic Minority_enrollment].ONE_GIRL))>0) AND ((Sum([Ethnic Minority_enrollment].TWO_BOY))>0) AND ((Sum([Ethnic Minority_enrollment].TWO_GIRL))>0) AND ((Sum([Ethnic Minority_enrollment].THREE_BOY))>0) AND ((Sum([Ethnic Minority_enrollment].THREE_GIRL))>0) AND ((Sum([Ethnic Minority_enrollment].FOUR_BOY))>0) AND ((Sum([Ethnic Minority_enrollment].FOUR_GIRL))>0) AND ((Sum([Ethnic Minority_enrollment].FIVE_BOY))>0) AND ((Sum([Ethnic Minority_enrollment].FIVE_GIRL))>0));



