Query Name: 24 Schools
--------------------------------------------------------------------------------
SELECT GEN_INFO.[24 School], edn_thana.DIVISION_NAME, edn_thana.DISTRICT_NAME, edn_thana.UPAZILA_NAME, GEN_INFO.SCHOOL_CODE, GEN_INFO.SCHOOL_NAME_ENG, GEN_INFO.SCHOOL_NAME_BAN, Students_All.PRE_PRIMARY_BOY, Students_All.PRE_PRIMARY_GIRL, Students_All.TotalStudent, Teacher.Teacher
FROM ((edn_thana INNER JOIN GEN_INFO ON edn_thana.AREA_CODE_Txt = GEN_INFO.AREA_CODE) LEFT JOIN Students_All ON GEN_INFO.SCHOOL_CODE = Students_All.SCHOOL_CODE) LEFT JOIN Teacher ON GEN_INFO.SCHOOL_CODE = Teacher.SCHOOL_CODE
WHERE (((GEN_INFO.[24 School])="24"));



================================================================================
Query Name: 4_psql_Summary
--------------------------------------------------------------------------------
SELECT GEN_INFO.DIVISION_NAME, GEN_INFO.DISTRICT_NAME, GEN_INFO.UPAZILA_NAME, GEN_INFO.SCHOOL_TYPE_ID, GEN_INFO.SCHOOL_CODE, GEN_INFO.NO_OF_SHIFTS, GEN_INFO.SCHOOL_NAME_ENG, GEN_INFO.SCHOOL_NAME_BAN, STD_ADMISSION.PRE_PRIMARY_BOY, STD_ADMISSION.PRE_PRIMARY_GIRL, STD_ADMISSION.ONE_BOY, STD_ADMISSION.ONE_GIRL, STD_ADMISSION.TWO_BOY, STD_ADMISSION.TWO_GIRL, STD_ADMISSION.THREE_BOY, STD_ADMISSION.THREE_GIRL, STD_ADMISSION.FOUR_BOY, STD_ADMISSION.FOUR_GIRL, STD_ADMISSION.FIVE_BOY, STD_ADMISSION.FIVE_GIRL, [Number of Classrooms by Schools].SumOfCountOfSCHOOL_CODE, GPS_Teacher.Teacher, [FIVE_BOY]+[FIVE_GIRL]+[FOUR_BOY]+[FOUR_GIRL]+[ONE_BOY]+[ONE_GIRL]+[PRE_PRIMARY_BOY]+[PRE_PRIMARY_GIRL]+[THREE_BOY]+[THREE_GIRL]+[TWO_BOY]+[TWO_GIRL] AS Students, [Students]/[Teacher] AS STR, [Students]/[SumOfCountOfSCHOOL_CODE] AS SCR, IIf([SCR]<=25 And [STR]<=25 And [SumOfCountOfSCHOOL_CODE]>=6 And [Teacher]>=6,1,0) AS Condition_Satisfy
FROM ((GEN_INFO INNER JOIN STD_ADMISSION ON GEN_INFO.SCHOOL_CODE = STD_ADMISSION.SCHOOL_CODE) INNER JOIN [Number of Classrooms by Schools] ON STD_ADMISSION.SCHOOL_CODE = [Number of Classrooms by Schools].SCHOOL_CODE) INNER JOIN GPS_Teacher ON GEN_INFO.SCHOOL_CODE = GPS_Teacher.SCHOOL_CODE
GROUP BY GEN_INFO.DIVISION_NAME, GEN_INFO.DISTRICT_NAME, GEN_INFO.UPAZILA_NAME, GEN_INFO.SCHOOL_TYPE_ID, GEN_INFO.SCHOOL_CODE, GEN_INFO.NO_OF_SHIFTS, GEN_INFO.SCHOOL_NAME_ENG, GEN_INFO.SCHOOL_NAME_BAN, STD_ADMISSION.PRE_PRIMARY_BOY, STD_ADMISSION.PRE_PRIMARY_GIRL, STD_ADMISSION.ONE_BOY, STD_ADMISSION.ONE_GIRL, STD_ADMISSION.TWO_BOY, STD_ADMISSION.TWO_GIRL, STD_ADMISSION.THREE_BOY, STD_ADMISSION.THREE_GIRL, STD_ADMISSION.FOUR_BOY, STD_ADMISSION.FOUR_GIRL, STD_ADMISSION.FIVE_BOY, STD_ADMISSION.FIVE_GIRL, [Number of Classrooms by Schools].SumOfCountOfSCHOOL_CODE, GPS_Teacher.Teacher, [FIVE_BOY]+[FIVE_GIRL]+[FOUR_BOY]+[FOUR_GIRL]+[ONE_BOY]+[ONE_GIRL]+[PRE_PRIMARY_BOY]+[PRE_PRIMARY_GIRL]+[THREE_BOY]+[THREE_GIRL]+[TWO_BOY]+[TWO_GIRL]
HAVING (((GEN_INFO.SCHOOL_TYPE_ID)=2026 Or (GEN_INFO.SCHOOL_TYPE_ID)=2027 Or (GEN_INFO.SCHOOL_TYPE_ID)=2029) AND ((GEN_INFO.NO_OF_SHIFTS)<>1))
ORDER BY GEN_INFO.DIVISION_NAME, GEN_INFO.DISTRICT_NAME, GEN_INFO.UPAZILA_NAME;



