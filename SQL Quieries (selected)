Query Name: Ethnic Minority
--------------------------------------------------------------------------------
SELECT Thana_List.DIVISION_NAME, Thana_List.DISTRICT_NAME, Sum([Ethnic Minority_enrollment].PRE_PRIMARY_BOY) AS SumOfPRE_PRIMARY_BOY, Sum([Ethnic Minority_enrollment].PRE_PRIMARY_GIRL) AS SumOfPRE_PRIMARY_GIRL, Sum([Ethnic Minority_enrollment].ONE_BOY) AS SumOfONE_BOY, Sum([Ethnic Minority_enrollment].ONE_GIRL) AS SumOfONE_GIRL, Sum([Ethnic Minority_enrollment].TWO_BOY) AS SumOfTWO_BOY, Sum([Ethnic Minority_enrollment].TWO_GIRL) AS SumOfTWO_GIRL, Sum([Ethnic Minority_enrollment].THREE_BOY) AS SumOfTHREE_BOY, Sum([Ethnic Minority_enrollment].THREE_GIRL) AS SumOfTHREE_GIRL, Sum([Ethnic Minority_enrollment].FOUR_BOY) AS SumOfFOUR_BOY, Sum([Ethnic Minority_enrollment].FOUR_GIRL) AS SumOfFOUR_GIRL, Sum([Ethnic Minority_enrollment].FIVE_BOY) AS SumOfFIVE_BOY, Sum([Ethnic Minority_enrollment].FIVE_GIRL) AS SumOfFIVE_GIRL
FROM Thana_List INNER JOIN [Ethnic Minority_enrollment] ON Thana_List.AREA_CODE = [Ethnic Minority_enrollment].UPAZILA_CODE
GROUP BY Thana_List.DIVISION_NAME, Thana_List.DISTRICT_NAME;





