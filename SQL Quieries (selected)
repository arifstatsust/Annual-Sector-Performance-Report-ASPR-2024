================================================================================
Query Name: Stuent_Teacher WB
--------------------------------------------------------------------------------
SELECT Total_Student.SCHOOL_CODE, [PPE_Boy]+[PPE_Girl] AS PPE, Total_Student.Grade1, Total_Student.Grade2, Total_Student.Grade3, Total_Student.Grade4, Total_Student.Grade5, Teacher.Teacher AS [Number of Total Teachers]
FROM (Total_Student LEFT JOIN Teacher ON Total_Student.SCHOOL_CODE = Teacher.SCHOOL_CODE) LEFT JOIN PPE_5yrs_Total ON Total_Student.SCHOOL_CODE = PPE_5yrs_Total.SCHOOL_CODE;



================================================================================
Query Name: Teacher
--------------------------------------------------------------------------------
SELECT Thana_List.DIVISION_NAME, Thana_List.DISTRICT_NAME, SCHOOL_TYPE.Order_New, SCHOOL_TYPE.NAME_New, TEACHER_LIST.SCHOOL_CODE, Count(TEACHER_LIST.GENDER) AS Teacher
FROM (Thana_List INNER JOIN TEACHER_LIST ON Thana_List.AREA_CODE = TEACHER_LIST.UPA_CODE) INNER JOIN SCHOOL_TYPE ON TEACHER_LIST.SCHOOL_TYPE_ID = SCHOOL_TYPE.SCHOOL_TYPE_ID
GROUP BY Thana_List.DIVISION_NAME, Thana_List.DISTRICT_NAME, SCHOOL_TYPE.Order_New, SCHOOL_TYPE.NAME_New, TEACHER_LIST.SCHOOL_CODE;



================================================================================
Query Name: teacher by post_by ARIF
--------------------------------------------------------------------------------
SELECT SCHOOL_TYPE.Order_New, TEACHER_LIST.SCHOOL_TYPE_ID, TEACHER_LIST.SCHOOL_CODE, TEACHER_LIST.POST_ID, [teacher_Post ID].DESIGNATION_ID, [teacher_Post ID].NAME, TEACHER_LIST.GENDER, Count(TEACHER_LIST.PIN_NO) AS CountOfPIN_NO
FROM (TEACHER_LIST INNER JOIN [teacher_Post ID] ON TEACHER_LIST.POST_ID = [teacher_Post ID].DESIGNATION_ID) INNER JOIN SCHOOL_TYPE ON TEACHER_LIST.SCHOOL_TYPE_ID = SCHOOL_TYPE.SCHOOL_TYPE_ID
GROUP BY SCHOOL_TYPE.Order_New, TEACHER_LIST.SCHOOL_TYPE_ID, TEACHER_LIST.SCHOOL_CODE, TEACHER_LIST.POST_ID, [teacher_Post ID].DESIGNATION_ID, [teacher_Post ID].NAME, TEACHER_LIST.GENDER
HAVING (((SCHOOL_TYPE.Order_New)=1));



================================================================================
Query Name: Teacher_Total_GPS
--------------------------------------------------------------------------------
SELECT Teacher.DIVISION_NAME, Teacher.DISTRICT_NAME, Count(Teacher.GENDER) AS CountOfGENDER
FROM Teacher
GROUP BY Teacher.DIVISION_NAME, Teacher.DISTRICT_NAME;



================================================================================
Query Name: Teachers by School
--------------------------------------------------------------------------------
SELECT TEACHER_LIST.UPA_CODE, TEACHER_LIST.SCHOOL_CODE, TEACHER_LIST.SCHOOL_TYPE_ID, TEACHER_LIST.GENDER, Count(TEACHER_LIST.PIN_NO) AS CountOfPIN_NO
FROM TEACHER_LIST
GROUP BY TEACHER_LIST.UPA_CODE, TEACHER_LIST.SCHOOL_CODE, TEACHER_LIST.SCHOOL_TYPE_ID, TEACHER_LIST.GENDER;



================================================================================
Query Name: teacher's training
--------------------------------------------------------------------------------
SELECT TEACHER_LIST.GENDER, GOVT_TEACHER_TRAINING.NAME_LOCAL, Count(GOVT_TEACHER_TRAINING.PIN_NO) AS CountOfPIN_NO
FROM TEACHER_LIST INNER JOIN GOVT_TEACHER_TRAINING ON TEACHER_LIST.PIN_NO = GOVT_TEACHER_TRAINING.PIN_NO
GROUP BY TEACHER_LIST.GENDER, GOVT_TEACHER_TRAINING.NAME_LOCAL;



================================================================================
Query Name: Total_Student
--------------------------------------------------------------------------------
SELECT STD_ADMISSION.SCHOOL_CODE, Sum([ONE_BOY]+[ONE_GIRL]) AS Grade1, Sum([TWO_BOY]+[TWO_GIRL]) AS Grade2, Sum([THREE_BOY]+[THREE_GIRL]) AS Grade3, Sum([FOUR_BOY]+[FOUR_GIRL]) AS Grade4, Sum([FIVE_BOY]+[FIVE_GIRL]) AS Grade5
FROM STD_ADMISSION
GROUP BY STD_ADMISSION.SCHOOL_CODE;



================================================================================
Query Name: Trained_Teacher_ALL Types
--------------------------------------------------------------------------------
SELECT TEACHER_LIST.UPA_CODE, TEACHER_LIST.SCHOOL_CODE, GOVT_TEACHER_TRAINING.PIN_NO, TEACHER_LIST.SCHOOL_TYPE_ID, TEACHER_LIST.[Teacher Name], TEACHER_LIST.GENDER, Training_Code.Training_Name, Training_Code.Training_Name_eng, Training_Code.Code, GOVT_TEACHER_TRAINING.NAME_LOCAL, IIf([Code]=5,"BEd",Null) AS BEd, IIf([Code]=24,"MEd",Null) AS MEd, IIf([Code]=8,"C_in-Ed",Null) AS [C-in-Ed], IIf([Code]=15,"DPEd",Null) AS DPEd, IIf([Code]=31,"PPE",Null) AS PPE, IIf([Code]=36,"Sub_eng",Null) AS Sub_eng, IIf([Code]=39,"Sub_Social",Null) AS Sub_Social, IIf([Code]=17,"ICT_Edu",Null) AS ICT_Edu, IIf(([BEd] Is Not Null Or [MEd] Is Not Null Or [C-in-Ed] Is Not Null Or [DPED] Is Not Null),1,Null) AS Trained_teacher, IIf(([C-in-Ed] Is Not Null Or [DPED] Is Not Null),1,Null) AS [C-in-Ed_DPED], IIf(([C-in-Ed] Is Not Null And [DPED] Is Not Null),1,Null) AS [BothC-in-Ed_DPED]
FROM Training_Code INNER JOIN (TEACHER_LIST INNER JOIN GOVT_TEACHER_TRAINING ON TEACHER_LIST.PIN_NO = GOVT_TEACHER_TRAINING.PIN_NO) ON Training_Code.Training_Name = GOVT_TEACHER_TRAINING.NAME_LOCAL;



================================================================================
Query Name: Trained_Teacher_Final
--------------------------------------------------------------------------------
SELECT Thana_List.DIVISION_NAME, Thana_List.DISTRICT_NAME, Sum(IIf(([C-in-Ed]="C_In-Ed" And [Gender]="MALE"),1,Null)) AS Male_CInED, Sum(IIf(([C-in-Ed]="C_In-Ed" And [Gender]="FEMALE"),1,Null)) AS Feale_CInED, Sum(IIf(([DPED]="DPEd" And [Gender]="MALE"),1,Null)) AS Male_DPED, Sum(IIf(([DPED]="DPEd" And [Gender]="FEMALE"),1,Null)) AS Female_DPED
FROM Thana_List INNER JOIN Trained_TeacherGPS ON Thana_List.AREA_CODE = Trained_TeacherGPS.UPA_CODE
GROUP BY Thana_List.DIVISION_NAME, Thana_List.DISTRICT_NAME;



================================================================================
Query Name: Trained_TeacherGPS
--------------------------------------------------------------------------------
SELECT TEACHER_LIST.UPA_CODE, TEACHER_LIST.SCHOOL_CODE, GOVT_TEACHER_TRAINING.PIN_NO, TEACHER_LIST.SCHOOL_TYPE_ID, TEACHER_LIST.[Teacher Name], TEACHER_LIST.GENDER, Training_Code.Training_Name, Training_Code.Training_Name_eng, Training_Code.Code, GOVT_TEACHER_TRAINING.NAME_LOCAL, IIf([Code]=5,"BEd",Null) AS BEd, IIf([Code]=24,"MEd",Null) AS MEd, IIf([Code]=8,"C_in-Ed",Null) AS [C-in-Ed], IIf([Code]=15,"DPEd",Null) AS DPEd, IIf([Code]=31,"PPE",Null) AS PPE, IIf([Code]=36,"Sub_eng",Null) AS Sub_eng, IIf([Code]=39,"Sub_Social",Null) AS Sub_Social, IIf([Code]=17,"ICT_Edu",Null) AS ICT_Edu, IIf(([BEd] Is Not Null Or [MEd] Is Not Null Or [C-in-Ed] Is Not Null Or [DPED] Is Not Null),1,Null) AS Trained_teacher, IIf(([C-in-Ed] Is Not Null Or [DPED] Is Not Null),1,Null) AS [C-in-Ed_DPED], IIf(([C-in-Ed] Is Not Null And [DPED] Is Not Null),1,Null) AS [BothC-in-Ed_DPED]
FROM Training_Code INNER JOIN (TEACHER_LIST INNER JOIN GOVT_TEACHER_TRAINING ON TEACHER_LIST.PIN_NO = GOVT_TEACHER_TRAINING.PIN_NO) ON Training_Code.Training_Name = GOVT_TEACHER_TRAINING.NAME_LOCAL
WHERE (((TEACHER_LIST.SCHOOL_TYPE_ID)=2026 Or (TEACHER_LIST.SCHOOL_TYPE_ID)=2027 Or (TEACHER_LIST.SCHOOL_TYPE_ID)=2029));



================================================================================
Query Name: Union Schools
--------------------------------------------------------------------------------
SELECT Thana_List.DIVISION_NAME, Thana_List.DISTRICT_NAME, Thana_List.UPAZILA_NAME, GEN_INFO.UPAZILA_CODE, GEN_INFO.SCHOOL_TYPE_ID, SCHOOL_TYPE.NAME, GEN_INFO.UNION_CODE, GEN_INFO.UNION_NAME, GEN_INFO.SCHOOL_NAME_ENG
FROM (Thana_List INNER JOIN GEN_INFO ON Thana_List.AREA_CODE = GEN_INFO.UPAZILA_CODE) INNER JOIN SCHOOL_TYPE ON GEN_INFO.SCHOOL_TYPE_ID = SCHOOL_TYPE.SCHOOL_TYPE_ID
GROUP BY Thana_List.DIVISION_NAME, Thana_List.DISTRICT_NAME, Thana_List.UPAZILA_NAME, GEN_INFO.UPAZILA_CODE, GEN_INFO.SCHOOL_TYPE_ID, SCHOOL_TYPE.NAME, GEN_INFO.UNION_CODE, GEN_INFO.UNION_NAME, GEN_INFO.SCHOOL_NAME_ENG;



================================================================================
Query Name: WASH_Electricity
--------------------------------------------------------------------------------
SELECT school_wash.EMIS_CODE, school_wash.SCHOOL_TYPE_ID, GEN_INFO.DIVISION_NAME, GEN_INFO.DISTRICT_NAME, GEN_INFO.EMIS_CODE, IIf([PLAYFIELD_yn]="?????","Yes",Null) AS Play_Field, IIf([AREA_WALL_yn]="?????","Yes",Null) AS Area_Wall, IIf([WASHBLOCK_yn]="?????","Yes",Null) AS WASH_BLOCK, IIf([POWER_CONNECTION]=1,"Yes",Null) AS Electricity
FROM school_wash INNER JOIN GEN_INFO ON school_wash.EMIS_CODE = GEN_INFO.EMIS_CODE;



================================================================================
Query Name: Basic_Information
--------------------------------------------------------------------------------
SELECT edn_thana.DIVISION_NAME, Sum(IIf([NAME_PLATE]=1,1,Null)) AS NAMEPLATE, Sum(IIf([BASIC_INFO_DISPLAYED]=1,1,Null)) AS BASIC_INFO_DISP, Sum(IIf([SLIP_ACTIVITIES]=1,1,Null)) AS SLIP_ACTIVITY, Sum(IIf([SCOUT_CLUB_ACTIVITIES]=1,1,Null)) AS SCOUT_CLUBACTIVITY, Sum(IIf([CLUB_TEAM_STOCK]=1,1,Null)) AS CLUB_TEAMSTOCK, Sum(IIf([SOCIAL_AUDIT]=1,1,Null)) AS SOCIALAUDIT, Sum(IIf([INNOVATION_ACTIVITIES]=1,1,Null)) AS INNOVATION_ACTIVITY, Sum(IIf([SCHOOL_FOR_DISABLED]=1,1,Null)) AS SCHOOL_DISABLED, Sum(IIf([SCHOOL_GATE]=1,1,Null)) AS SCHOOLgate, Sum(IIf([SHELTER_CUM_SCHOOL]=1,1,Null)) AS SHELTER_CUMSchool, Sum(IIf([SAFE_DRINKING_WATER]=1,1,Null)) AS SAFE_DRINK_WATER, Sum(IIf([LIBERATION_WAR_CORNER]=1,1,Null)) AS LIBERATION_WARCorner, Sum(IIf([HONESTY_STORE]=1,1,Null)) AS HONESTYStore, Sum(IIf([BOOK_CORNER]=1,1,Null)) AS BOOKconer, Sum(IIf([WALLS_OF_HUMANITY]=1,1,Null)) AS WALLS_humanity, Sum(IIf([DIRECTIONAL_BLADE]=1,1,Null)) AS DIRECTIONALblade, Sum(IIf([FIRST_AID_KIT]=1,1,Null)) AS FIRST_AIDkit, Sum(IIf([FIRE_EXTINGUISHER]=1,1,Null)) AS FIREextinguisher, Sum(IIf([RAMP]=1,1,Null)) AS RAMP_have, Sum(IIf([DAISY_BOOK]=1,1,0)) AS DAISYbook, Sum(IIf([BRAILLE_BOOK]=1,1,Null)) AS BRAILLEbokkk, Sum(IIf([WHEELCHAIR]=1,1,Null)) AS WHEEL_CHAIR, Sum(IIf([SIGN_LANG_MANUAL]=1,1,Null)) AS SIGN_LANGmanual, Sum(IIf([SIGN_LANG_TUTOR]=1,1,Null)) AS SIGN_LANGtotor, Sum(IIf([CRUTCHES]=1,1,Null)) AS _CRUTCHES, Sum(IIf([VISION_FENCING]=1,1,Null)) AS VISIONfencing, Sum(IIf([SILENT_ENVIRONMENT]=1,1,Null)) AS SILENTenvironment, Sum(IIf([COLOR_CONTRAST]=1,1,Null)) AS COLORcontrast, Sum(IIf([HEARING_AID]=1,1,Null)) AS HEARINGaid, Sum(IIf([USE_OF_DISINFECTANT]=1,1,Null)) AS USE_OFdisinfectant, Sum(IIf([POWER_CONNECTION]=1,1,Null)) AS POWERconnection, Sum(IIf([INTERNET_FACILITY]=1,1,Null)) AS INTERNETfacility, Sum(IIf([LITTLE_DOCTOR_ACTIVITIES]=1,1,Null)) AS LITTLE_DOCTORactivities, Sum(IIf([EARLY_WARNING_ACTIVITIES]=1,1,Null)) AS EARLY_WARNINGactivities, Sum(IIf([STUDENT_COUNCIL]=1,1,Null)) AS STUDENTcouncil, Sum(IIf([PLAYGROUND]=1,1,Null)) AS PLAY_GROUND, Sum(IIf([WITH_BOUNDARY]=1,1,Null)) AS Palyground_WITH_BOUNDARY, Sum(IIf([SPORTS_EQUIPMENT]=1,1,Null)) AS SPORTSequipment, Sum(IIf([STUDENT_WELFARE]=1,1,Null)) AS STUDENTwelfare
FROM edn_thana INNER JOIN GPS_Geninfo ON edn_thana.AREA_CODE = GPS_Geninfo.AREA_CODE
GROUP BY edn_thana.DIVISION_NAME;



