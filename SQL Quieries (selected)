--------------------------------------------------------------------------------
SELECT STD_ADMISSION.SCHOOL_TYPE_ID, GEN_INFO.DIVISION_NAME, GEN_INFO.DISTRICT_NAME, GEN_INFO.UPAZILA_NAME, STD_ADMISSION.SCHOOL_CODE, GEN_INFO.SCHOOL_NAME_ENG, GEN_INFO.SCHOOL_NAME_BAN, STD_ADMISSION.PRE_PRIMARY_BOY, STD_ADMISSION.PRE_PRIMARY_GIRL, STD_ADMISSION.ONE_BOY, STD_ADMISSION.ONE_GIRL, STD_ADMISSION.TWO_BOY, STD_ADMISSION.TWO_GIRL, STD_ADMISSION.THREE_BOY, STD_ADMISSION.THREE_GIRL, STD_ADMISSION.FOUR_BOY, STD_ADMISSION.FOUR_GIRL, STD_ADMISSION.FIVE_BOY, STD_ADMISSION.FIVE_GIRL, [FIVE_BOY]+[FIVE_GIRL]+[FOUR_BOY]+[FOUR_GIRL]+[ONE_BOY]+[ONE_GIRL]+[PRE_PRIMARY_BOY]+[PRE_PRIMARY_GIRL]+[THREE_BOY]+[THREE_GIRL]+[TWO_BOY]+[TWO_GIRL] AS Total
FROM STD_ADMISSION INNER JOIN GEN_INFO ON STD_ADMISSION.SCHOOL_CODE = GEN_INFO.SCHOOL_CODE
WHERE (((STD_ADMISSION.SCHOOL_TYPE_ID)=2026 Or (STD_ADMISSION.SCHOOL_TYPE_ID)=2027 Or (STD_ADMISSION.SCHOOL_TYPE_ID)=2029) AND (([FIVE_BOY]+[FIVE_GIRL]+[FOUR_BOY]+[FOUR_GIRL]+[ONE_BOY]+[ONE_GIRL]+[PRE_PRIMARY_BOY]+[PRE_PRIMARY_GIRL]+[THREE_BOY]+[THREE_GIRL]+[TWO_BOY]+[TWO_GIRL])>=301 And ([FIVE_BOY]+[FIVE_GIRL]+[FOUR_BOY]+[FOUR_GIRL]+[ONE_BOY]+[ONE_GIRL]+[PRE_PRIMARY_BOY]+[PRE_PRIMARY_GIRL]+[THREE_BOY]+[THREE_GIRL]+[TWO_BOY]+[TWO_GIRL])<=500));



================================================================================
Query Name: GPS_Teacher
--------------------------------------------------------------------------------
SELECT TEACHER_LIST.SCHOOL_TYPE_ID, Thana_List.DIVISION_NAME, Thana_List.DISTRICT_NAME, SCHOOL_TYPE.Order_New, SCHOOL_TYPE.NAME_New, TEACHER_LIST.SCHOOL_CODE, Count(TEACHER_LIST.GENDER) AS Teacher
FROM (Thana_List INNER JOIN TEACHER_LIST ON Thana_List.AREA_CODE = TEACHER_LIST.UPA_CODE) INNER JOIN SCHOOL_TYPE ON TEACHER_LIST.SCHOOL_TYPE_ID = SCHOOL_TYPE.SCHOOL_TYPE_ID
GROUP BY TEACHER_LIST.SCHOOL_TYPE_ID, Thana_List.DIVISION_NAME, Thana_List.DISTRICT_NAME, SCHOOL_TYPE.Order_New, SCHOOL_TYPE.NAME_New, TEACHER_LIST.SCHOOL_CODE
HAVING (((TEACHER_LIST.SCHOOL_TYPE_ID)=2026 Or (TEACHER_LIST.SCHOOL_TYPE_ID)=2027 Or (TEACHER_LIST.SCHOOL_TYPE_ID)=2029));



================================================================================
Query Name: No of Classrooms
--------------------------------------------------------------------------------
SELECT ROOM.SCHOOL_CODE, GEN_INFO.AREA_CODE, ROOM.SCHOOL_TYPE_ID, ROOM.USAGE_PURPOSE, Count(ROOM.SCHOOL_CODE) AS CountOfSCHOOL_CODE
FROM GEN_INFO INNER JOIN ROOM ON GEN_INFO.SCHOOL_CODE = ROOM.SCHOOL_CODE
GROUP BY ROOM.SCHOOL_CODE, GEN_INFO.AREA_CODE, ROOM.SCHOOL_TYPE_ID, ROOM.USAGE_PURPOSE
HAVING (((ROOM.USAGE_PURPOSE)=3114 Or (ROOM.USAGE_PURPOSE)=15));



================================================================================
Query Name: Number of Classrooms by Schools
--------------------------------------------------------------------------------
SELECT [No of Classrooms].SCHOOL_CODE, [No of Classrooms].AREA_CODE, Sum([No of Classrooms].CountOfSCHOOL_CODE) AS SumOfCountOfSCHOOL_CODE
FROM [No of Classrooms]
GROUP BY [No of Classrooms].SCHOOL_CODE, [No of Classrooms].AREA_CODE;



================================================================================
Query Name: PPE
--------------------------------------------------------------------------------
SELECT STD_ADMISSION.UPAZILA_CODE, Thana_List.AREA_CODE, Thana_List.DIVISION_NAME, Thana_List.DISTRICT_NAME, Thana_List.UPAZILA_NAME, STD_ADMISSION.SCHOOL_TYPE_ID, SCHOOL_TYPE.SCHOOL_TYPE_ID_New, SCHOOL_TYPE.Order_New, STD_ADMISSION.PRE_PRIMARY_BOY, STD_ADMISSION.PRE_PRIMARY_GIRL, [PRE_PRIMARY_BOY]+[PRE_PRIMARY_GIRL] AS TotalPPE
FROM (Thana_List INNER JOIN STD_ADMISSION ON Thana_List.AREA_CODE = STD_ADMISSION.UPAZILA_CODE) INNER JOIN SCHOOL_TYPE ON (SCHOOL_TYPE.SCHOOL_TYPE_ID = STD_ADMISSION.SCHOOL_TYPE_ID) AND (STD_ADMISSION.SCHOOL_TYPE_ID = SCHOOL_TYPE.SCHOOL_TYPE_ID)
WHERE ((([PRE_PRIMARY_BOY]+[PRE_PRIMARY_GIRL])>0));



================================================================================
Query Name: PPE_5+Year
--------------------------------------------------------------------------------
SELECT AGE_WISE_ADMISSION.SCHOOL_CODE, AGE_WISE_ADMISSION.AGE, Sum(AGE_WISE_ADMISSION.PRE_PRIMARY_BOY) AS SumOfPRE_PRIMARY_BOY, Sum(AGE_WISE_ADMISSION.PRE_PRIMARY_GIRL) AS SumOfPRE_PRIMARY_GIRL
FROM AGE_WISE_ADMISSION
GROUP BY AGE_WISE_ADMISSION.SCHOOL_CODE, AGE_WISE_ADMISSION.AGE
HAVING (((AGE_WISE_ADMISSION.AGE)=5 Or (AGE_WISE_ADMISSION.AGE)=6 Or (AGE_WISE_ADMISSION.AGE)=7));



================================================================================
Query Name: PPE_5yrs_Total
--------------------------------------------------------------------------------
SELECT [PPE_5+Year].SCHOOL_CODE, Sum([PPE_5+Year].SumOfPRE_PRIMARY_BOY) AS PPE_Boy, Sum([PPE_5+Year].SumOfPRE_PRIMARY_GIRL) AS PPE_Girl
FROM [PPE_5+Year]
GROUP BY [PPE_5+Year].SCHOOL_CODE;



================================================================================
Query Name: PPE_Inforamtion
--------------------------------------------------------------------------------
SELECT SCHOOL_TYPE.Order_New, SCHOOL_TYPE.NAME_New, Thana_List.DIVISION_NAME, Thana_List.DISTRICT_NAME, STD_ADMISSION.PRE_PRIMARY_BOY, STD_ADMISSION.PRE_PRIMARY_GIRL, [PRE_PRIMARY_BOY]+[PRE_PRIMARY_Girl] AS PPE
FROM (STD_ADMISSION INNER JOIN SCHOOL_TYPE ON STD_ADMISSION.SCHOOL_TYPE_ID = SCHOOL_TYPE.SCHOOL_TYPE_ID) INNER JOIN Thana_List ON STD_ADMISSION.UPAZILA_CODE = Thana_List.AREA_CODE
WHERE (((SCHOOL_TYPE.Order_New)=6) AND (([PRE_PRIMARY_BOY]+[PRE_PRIMARY_Girl])>0));



================================================================================
Query Name: School_enrolment
--------------------------------------------------------------------------------
SELECT GEN_INFO.DIVISION_NAME, GEN_INFO.SCHOOL_TYPE_ID, GEN_INFO.SCHOOL_CODE, STD_ADMISSION.PRE_PRIMARY_BOY, STD_ADMISSION.PRE_PRIMARY_GIRL, STD_ADMISSION.ONE_BOY, STD_ADMISSION.ONE_GIRL, STD_ADMISSION.TWO_BOY, STD_ADMISSION.TWO_GIRL, STD_ADMISSION.THREE_BOY, STD_ADMISSION.THREE_GIRL, STD_ADMISSION.FOUR_BOY, STD_ADMISSION.FOUR_GIRL, STD_ADMISSION.FIVE_BOY, STD_ADMISSION.FIVE_GIRL
FROM GEN_INFO INNER JOIN STD_ADMISSION ON GEN_INFO.SCHOOL_CODE = STD_ADMISSION.SCHOOL_CODE
GROUP BY GEN_INFO.DIVISION_NAME, GEN_INFO.SCHOOL_TYPE_ID, GEN_INFO.SCHOOL_CODE, STD_ADMISSION.PRE_PRIMARY_BOY, STD_ADMISSION.PRE_PRIMARY_GIRL, STD_ADMISSION.ONE_BOY, STD_ADMISSION.ONE_GIRL, STD_ADMISSION.TWO_BOY, STD_ADMISSION.TWO_GIRL, STD_ADMISSION.THREE_BOY, STD_ADMISSION.THREE_GIRL, STD_ADMISSION.FOUR_BOY, STD_ADMISSION.FOUR_GIRL, STD_ADMISSION.FIVE_BOY, STD_ADMISSION.FIVE_GIRL
HAVING (((GEN_INFO.SCHOOL_TYPE_ID)=2026 Or (GEN_INFO.SCHOOL_TYPE_ID)=2027 Or (GEN_INFO.SCHOOL_TYPE_ID)=2029));



================================================================================
Query Name: SCR40
--------------------------------------------------------------------------------
SELECT Students_All.SCHOOL_CODE, Students_All.TotalStudent, Students_All.StuwithPPE, Class_Room_NotZero.Class_room, Class_Room_NotZero.TotalCLRooms, IIf([TotalStudent]/[Class_room]<=40,1,0) AS SCR40, IIf([StuwithPPE]/[TotalCLRooms]<=40,1,0) AS SCR40PPE
FROM Class_Room_NotZero INNER JOIN Students_All ON Class_Room_NotZero.SCHOOL_CODE = Students_All.SCHOOL_CODE;



================================================================================
Query Name: Six_Eight_Schools_2023
--------------------------------------------------------------------------------
SELECT edn_thana.DIVISION_NAME, edn_thana.DISTRICT_NAME, edn_thana.UPAZILA_NAME, GEN_INFO.SCHOOL_NAME_ENG, STD_ADMISSION.SCHOOL_CODE, STD_ADMISSION.PRE_PRIMARY_BOY, STD_ADMISSION.PRE_PRIMARY_GIRL, [PRE_PRIMARY_BOY]+[PRE_PRIMARY_GIRL] AS PPE, [ONE_BOY]+[TWO_BOY]+[THREE_BOY]+[FOUR_BOY]+[FIVE_BOY] AS Boys, [ONE_GIRL]+[TWO_GIRL]+[THREE_GIRL]+[FOUR_GIRL]+[FiVE_GIRL] AS Girls, [ONE_BOY]+[TWO_BOY]+[THREE_BOY]+[FOUR_BOY]+[FIVE_BOY]+[ONE_GIRL]+[TWO_GIRL]+[THREE_GIRL]+[FOUR_GIRL]+[FiVE_GIRL] AS TotalI_V, STD_ADMISSION.SIX_EIGHT_BOY, STD_ADMISSION.SIX_EIGHT_GIRL, [SIX_EIGHT_BOY]+[SIX_EIGHT_girl] AS TotalSIX_Eight, SCHOOL_TYPE.Order_New, Teacher.Teacher
FROM (edn_thana INNER JOIN ((STD_ADMISSION INNER JOIN SCHOOL_TYPE ON STD_ADMISSION.SCHOOL_TYPE_ID = SCHOOL_TYPE.SCHOOL_TYPE_ID) INNER JOIN GEN_INFO ON STD_ADMISSION.SCHOOL_CODE = GEN_INFO.SCHOOL_CODE) ON edn_thana.AREA_CODE = STD_ADMISSION.UPAZILA_CODE) INNER JOIN Teacher ON STD_ADMISSION.SCHOOL_CODE = Teacher.SCHOOL_CODE
WHERE ((([SIX_EIGHT_BOY]+[SIX_EIGHT_girl])>0) AND ((SCHOOL_TYPE.Order_New)=1));



================================================================================
Query Name: STR40
--------------------------------------------------------------------------------
SELECT Students_All.SCHOOL_CODE, Students_All.StuwithPPE, Teacher.Teacher, IIf([StuwithPPE]/[Teacher]<=40,1,0) AS STR40
FROM Teacher INNER JOIN Students_All ON Teacher.SCHOOL_CODE = Students_All.SCHOOL_CODE;



================================================================================
Query Name: Student_Final
--------------------------------------------------------------------------------
SELECT Total_Student_1.DIVISION_NAME AS Expr1, Sum(Total_Student_1.PRE_PRIMARY_BOY) AS SumOfPRE_PRIMARY_BOY, Sum(Total_Student_1.PRE_PRIMARY_GIRL) AS SumOfPRE_PRIMARY_GIRL, Sum(Total_Student_1.Total) AS SumOfTotal
