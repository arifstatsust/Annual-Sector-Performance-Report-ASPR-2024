Query Name: Data_Analysis
--------------------------------------------------------------------------------
SELECT Students_All.DIVISION_NAME, Students_All.DISTRICT_NAME, Students_All.UPAZILA_NAME, Students_All.SCHOOL_CODE, Students_All.Order_New, Students_All.SCHOOL_NAME_ENG, Students_All.ONE_BOY, Enrolment_All_2022.ONE_BOY, Students_All.ONE_GIRL, Enrolment_All_2022.ONE_GIRL, Students_All.TWO_BOY, Enrolment_All_2022.TWO_BOY, Students_All.TWO_GIRL, Enrolment_All_2022.TWO_GIRL, Students_All.THREE_BOY, Enrolment_All_2022.THREE_BOY, Students_All.THREE_GIRL, Enrolment_All_2022.THREE_GIRL, Students_All.FOUR_BOY, Enrolment_All_2022.FOUR_BOY, Students_All.FOUR_GIRL, Enrolment_All_2022.FOUR_GIRL, Students_All.FIVE_BOY, Enrolment_All_2022.FIVE_BOY, Students_All.FIVE_GIRL, Enrolment_All_2022.FIVE_GIRL, Students_All.TotalStudent, Enrolment_All_2022.Total, Students_All.Boys, Students_All.Girls, Teacher.Teacher, Class_Room.Class_room, Round([TotalStudent]/[Teacher],0) AS STR, Round([TotalStudent]/[Class_room],0) AS SCR, Students_All.[24 School], Round((([Enrolment_All_2022].[FIVE_BOY]+[Enrolment_All_2022].[FIVE_GIRL])-([Data_Repeater].[FIVE_REPEATING_BOY]+[Data_Repeater].[FIVE_REPEATING_Girl]))/([Enrolment_All_2022].[FIVE_BOY]+[Enrolment_All_2022].[FIVE_GIRL])*100,0) AS PassedRate, Round(([Enrolment_All_2022].[FIVE_BOY]+[Enrolment_All_2022].[FIVE_GIRL])-([Data_Repeater].[FIVE_REPEATING_BOY]+[Data_Repeater].[FIVE_REPEATING_Girl])) AS TotalPassed, ([Data_Repeater].[FIVE_REPEATING_BOY]+[Data_Repeater].[FIVE_REPEATING_Girl]) AS repGrd5, Data_Repeater.FIVE_REPEATING_BOY, Data_Repeater.FIVE_REPEATING_GIRL, Data_ICT.MULTIMEDIA_Class, Data_ICT.Computer
FROM ((Enrolment_All_2022 LEFT JOIN ((Students_All LEFT JOIN Teacher ON Students_All.SCHOOL_CODE = Teacher.SCHOOL_CODE) LEFT JOIN Class_Room ON Students_All.SCHOOL_CODE = Class_Room.SCHOOL_CODE) ON Enrolment_All_2022.SCHOOL_CODE = Students_All.SCHOOL_CODE) LEFT JOIN Data_Repeater ON Students_All.SCHOOL_CODE = Data_Repeater.SCHOOL_CODE) LEFT JOIN Data_ICT ON Students_All.SCHOOL_CODE = Data_ICT.SCHOOL_CODE
WHERE (((Students_All.Order_New)=1));



