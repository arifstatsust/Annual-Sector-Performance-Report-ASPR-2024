================================================================================
Query Name: students_PPE-G5(All schools)
--------------------------------------------------------------------------------
SELECT STD_ADMISSION.SCHOOL_CODE, STD_ADMISSION.SCHOOL_TYPE_ID, STD_ADMISSION.PRE_PRIMARY_BOY, STD_ADMISSION.PRE_PRIMARY_GIRL, STD_ADMISSION.PRE_PRIMARY_BOY, STD_ADMISSION.PRE_PRIMARY_GIRL, STD_ADMISSION.ONE_BOY, STD_ADMISSION.ONE_GIRL, STD_ADMISSION.TWO_BOY, STD_ADMISSION.TWO_GIRL, STD_ADMISSION.THREE_BOY, STD_ADMISSION.THREE_GIRL, STD_ADMISSION.FOUR_BOY, STD_ADMISSION.FOUR_GIRL, STD_ADMISSION.FIVE_BOY, STD_ADMISSION.FIVE_GIRL, [PRE_PRIMARY_BOY]+[PRE_PRIMARY_GIRL]+[ONE_BOY]+[ONE_GIRL]+[TWO_BOY]+[TWO_GIRL]+[THREE_BOY]+[THREE_GIRL]+[FOUR_BOY]+[FOUR_GIRL]+[FIVE_BOY]+[FIVE_GIRL] AS Total_stu
FROM STD_ADMISSION;



================================================================================
Query Name: Student-Teacher(ALL) by Arif
--------------------------------------------------------------------------------
SELECT [students_PPE-G5(All schools)].SCHOOL_CODE, [students_PPE-G5(All schools)].SCHOOL_TYPE_ID, SCHOOL_TYPE.Order_New, [students_PPE-G5(All schools)].Total_stu
FROM [students_PPE-G5(All schools)] INNER JOIN SCHOOL_TYPE ON [students_PPE-G5(All schools)].SCHOOL_TYPE_ID = SCHOOL_TYPE.SCHOOL_TYPE_ID
