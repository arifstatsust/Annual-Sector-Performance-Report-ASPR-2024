WHERE (((SCHOOL_TYPE.Order_New)<>1));



================================================================================
Query Name: Students_GPS
--------------------------------------------------------------------------------
SELECT STD_ADMISSION.SCHOOL_TYPE_ID, STD_ADMISSION.SCHOOL_CODE, [PRE_PRIMARY_BOY]+[ONE_BOY]+[TWO_BOY]+[THREE_BOY]+[FOUR_BOY]+[FIVE_BOY] AS Boys, [PRE_PRIMARY_GIRL]+[ONE_GIRL]+[TWO_GIRL]+[THREE_GIRL]+[FOUR_GIRL]+[FIVE_GIRL] AS Girls, [Boys]+[Girls] AS Total
FROM STD_ADMISSION
WHERE (((STD_ADMISSION.SCHOOL_TYPE_ID)=2026 Or (STD_ADMISSION.SCHOOL_TYPE_ID)=2027 Or (STD_ADMISSION.SCHOOL_TYPE_ID)=2029));



================================================================================
