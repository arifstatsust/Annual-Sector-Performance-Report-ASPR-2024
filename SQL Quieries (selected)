--------------------------------------------------------------------------------
SELECT Students_GPS.SCHOOL_CODE
FROM Students_GPS LEFT JOIN [No of Classrooms] ON Students_GPS.[SCHOOL_CODE] = [No of Classrooms].[SCHOOL_CODE]
